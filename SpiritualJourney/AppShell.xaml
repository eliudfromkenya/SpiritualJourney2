<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SpiritualJourney.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:SpiritualJourney.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="Spiritual Journey">

    <ShellContent
        Title="Login"
        Icon="{StaticResource IconLogin}"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login" />

    <ShellContent
        Title="Dashboard"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:DashboardPage}"
        Route="dashboard" />

    <ShellContent
        Title="Bible"
        Icon="{StaticResource IconBible}"
        ContentTemplate="{DataTemplate pages:BiblePage}"
        Route="bible" />

    <ShellContent
        Title="Memory"
        Icon="{StaticResource IconMemory}"
        ContentTemplate="{DataTemplate pages:MemoryReviewPage}"
        Route="memory" />

    <ShellContent
        Title="Hymns"
        Icon="{StaticResource IconHymns}"
        ContentTemplate="{DataTemplate pages:HymnsPage}"
        Route="hymns" />

    <ShellContent
        Title="Tasks"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:TasksPage}"
        Route="tasks" />

    <ShellContent
        Title="Sermons"
        Icon="{StaticResource IconSermons}"
        ContentTemplate="{DataTemplate pages:SermonsPage}"
        Route="sermons" />

    <ShellContent
        Title="Prayers"
        Icon="{StaticResource IconPrayers}"
        ContentTemplate="{DataTemplate pages:PrayersPage}"
        Route="prayers" />

    <ShellContent
        Title="Settings"
        Icon="{StaticResource IconSettings}"
        ContentTemplate="{DataTemplate pages:SettingsPage}"
        Route="settings" />

</Shell>
