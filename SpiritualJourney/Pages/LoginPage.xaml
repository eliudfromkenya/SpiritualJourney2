<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:pageModels="clr-namespace:SpiritualJourney.PageModels"
             x:Class="SpiritualJourney.Pages.LoginPage"
             x:DataType="pageModels:LoginPageModel"
             Title="Sign In">

    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom 30, Desktop=60}"
                              Spacing="20"
                              VerticalOptions="Center">

            <VerticalStackLayout Spacing="5"
                                 HorizontalOptions="Center">
                <Image Source="{StaticResource IconLogin}"
                       WidthRequest="64"
                       HeightRequest="64" />
                <Label Text="Spiritual Journey"
                       Style="{StaticResource Title1}"
                       HorizontalOptions="Center" />
                <Label Text="Grow in faith every day"
                       Style="{StaticResource Body2}"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <sf:SfTextInputLayout Hint="Email"
                                  ContainerType="Outlined">
                <Entry Text="{Binding Email}"
                       Keyboard="Email"
                       Placeholder="you@example.com" />
            </sf:SfTextInputLayout>

            <sf:SfTextInputLayout Hint="Password"
                                  ContainerType="Outlined"
                                  EnablePasswordVisibilityToggle="True">
                <Entry Text="{Binding Password}"
                       IsPassword="True"
                       Placeholder="Enter your password" />
            </sf:SfTextInputLayout>

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource Caption1}"
                   TextColor="{StaticResource Magenta}"
                   HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <Button Text="Sign In"
                    Command="{Binding SignInCommand}"
                    IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}" />

            <Label Text="OR"
                   Style="{StaticResource Caption1}"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />

            <Button Text="Continue with Google"
                    Command="{Binding SignInWithGoogleCommand}"
                    BackgroundColor="{StaticResource White}"
                    TextColor="{StaticResource Black}"
                    IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}" />

            <Button Text="Continue with Facebook"
                    Command="{Binding SignInWithFacebookCommand}"
                    BackgroundColor="#1877F2"
                    TextColor="{StaticResource White}"
                    IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
